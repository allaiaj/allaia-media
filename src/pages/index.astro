---
import BaseLayout from '@layouts/BaseLayout.astro';
import OfferHero from '@components/sections/OfferHero.astro';
import PortraitScrub from '@components/sections/PortraitScrub.astro';
import EditorialOpening from '@components/sections/EditorialOpening.astro';
import ChapterDivider from '@components/editorial/ChapterDivider.astro';
import PullQuoteInterlude from '@components/editorial/PullQuoteInterlude.astro';
import BookAnchor from '@components/sections/BookAnchor.astro';
import BookStanEmbed from '@components/sections/BookStanEmbed.astro';
import FourIdentities from '@components/sections/FourIdentities.astro';
import OperatorSection from '@components/sections/OperatorSection.astro';
import Architecture from '@components/sections/Architecture.astro';
import YouTubeFeatured from '@components/sections/YouTubeFeatured.astro';
import ReelsShowcase from '@components/sections/ReelsShowcase.astro';
import RuptureGallery from '@components/sections/RuptureGallery.astro';
import PressFeatures from '@components/sections/PressFeatures.astro';
import CovenWaitlist from '@components/sections/CovenWaitlist.astro';
import InstagramGrid from '@components/sections/InstagramGrid.astro';
import ClosingTiles from '@components/sections/ClosingTiles.astro';
---

<BaseLayout
  title="1:1 personal brand coaching — build a brand that pays you to live"
  description="Allaia builds personal brands, one to one. Twelve weeks — positioning, voice, the routines of becoming her, and the proof — so you leave the 9-to-5, earn from what you love, and live like every day feels like a vacation. By selection."
>
  <OfferHero />
  <EditorialOpening />

  <ChapterDivider
    numeral="01"
    eyebrow="THE OFFER · THE ARCHITECTURE"
    title="How it works."
    italic="Twelve weeks, one to one."
    body="The inner work and the outer: become her first, then build the brand around her — positioning, voice, rhythm, and the proof. Plus the setup to pitch brands and get paid. By selection."
    tone="dark"
  />

  <Architecture />

  <PullQuoteInterlude
    quote="The work is becoming the woman you are already about to be."
    attribution="From the diary"
    tone="cream"
  />

  <ChapterDivider
    numeral="02"
    eyebrow="THE PROOF · I'VE BUILT EXACTLY THIS"
    title="The receipts."
    italic="A life, on my own terms."
    body="6.8M views a quarter, brand collaborations across Bali, Ubud and Dubai, a book out 2026 — the proof the method works. If I can teach it, it is because I live it."
  />

  <PortraitScrub />
  <ReelsShowcase />
  <YouTubeFeatured />
  <FourIdentities />
  <OperatorSection />
  <PressFeatures compact={true} />
  <RuptureGallery />

  <ChapterDivider
    numeral="03"
    eyebrow="THE BOOK · THE METHOD, WRITTEN DOWN"
    title="Become Her."
    italic="Five parts. Twenty-two chapters."
    body="The foundational work everything in The Architecture is downstream of. Out 2026."
  />

  <BookAnchor />
  <BookStanEmbed />

  <ChapterDivider
    numeral="04"
    eyebrow="WHAT IS NEXT · THE COVEN"
    title="A room, in waiting."
    italic="For the women living it."
    body="A community for the women already doing the work — and the ones about to. By application. Launching slowly."
  />

  <CovenWaitlist />
  <InstagramGrid />
  <ClosingTiles />
</BaseLayout>
